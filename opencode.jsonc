{
	"$schema": "https://opencode.ai/config.json",

	// Minimal config for CI - no local tools or secrets
	"share": "manual",

	"permission": {
		"bash": "allow",
		"edit": "allow",
		"read": "allow",
		"grep": "allow",
		"glob": "allow",
		"write": "allow",
		"list": "allow",
		"todowrite": "allow",
		"todoread": "allow"
	}

	// No MCP servers - CI doesn't need them
}
